# Tool state — never product source. Recreated by tooling if the workflow returns.
.superpowers/
.playwright-cli/
.od-review/
.od-skills/
index.html.artifact.json

node_modules/
.next/
*.tsbuildinfo
.worktrees/
data/server/
data/storage/
.env
backups/

# Verification evidence stays outside the repository.
# Captures go to /tmp/opencode/eventouch-captures/ (see AGENTS.md); these guards
# only catch a stray write if some tool defaults back to an in-repo path.
design-inputs/
design-previews/

# Impeccable decision sketches — local review artifacts served by a static
# server during direction rounds. Surface briefs under .impeccable/surfaces/
# are committed; the mock sketches are not.
.impeccable/mocks/
.impeccable/questions/

# The operator's own files at the repository root (archives, plans) are not
# project assets: keep them out of every commit without touching them.
/*.zip
