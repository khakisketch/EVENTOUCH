# EVENTOUCH 서버 환경변수 예시. 실제 값은 tasks-manager 등 비밀 저장소에 둔다.
# 배포 전 체크: ADMIN_EMAIL/ADMIN_PASSWORD 설정됨, API_HOST_HERE 교체됨, COOKIE_SECURE 결정됨.
PORT=8776
NODE_ENV=production
EVENTOUCH_BUILD_REVISION=unknown
DATA_DIR=./data/server
STORAGE_DIR=./data/storage
POSTGRES_DB=eventouch
POSTGRES_USER=eventouch
# Compose용 DB 비밀번호. 비밀 저장소에 설정한다.
POSTGRES_PASSWORD=
# Compose 외부에서 직접 서버를 실행할 때 사용한다.
DATABASE_URL=postgresql://eventouch:<password>@localhost:5432/eventouch
SESSION_TTL_HOURS=12
# 외부 HTTPS 공개 시 1. 내부 HTTP 운영 시 0.
COOKIE_SECURE=0
# 최초 AGENCY 계정 생성에 둘 다 필요하다. 비밀값은 절대 커밋하지 않는다.
ADMIN_EMAIL=
ADMIN_NAME=관리자
ADMIN_PASSWORD=

# 참가자에게 발송되는 개인 티켓 링크의 기준 주소. {{티켓링크}} 변수에 사용된다.
# 미설정 상태에서 티켓링크 변수를 포함한 발송은 거부된다.
EVENTOUCH_PUBLIC_URL=

# 실제 프록시 IP/CIDR만 쉼표로 지정. 미설정은 전달 헤더를 신뢰하지 않는다.
# compose 기본값은 web 컨테이너의 고정 주소(10.89.0.10)이며, 그 컨테이너가
# X-Forwarded-For를 실제 접속 IP로 덮어쓴다. 외부 프록시를 앞에 둘 때만
# 추가 외부 프록시를 API 허용 목록에 넣는 것만으로 사용자 IP를 신뢰하지 않는다.
# 현재 웹 입구는 항상 직접 소켓 주소를 사용한다(배포 문서의 프록시 경계 참고).
EVENTOUCH_TRUSTED_PROXIES=
# compose 전용: 호스트의 다른 네트워크와 충돌하면 두 값을 함께 바꾼다.
# API의 기본 신뢰 주소도 EVENTOUCH_WEB_PROXY_IP를 따라간다.
EVENTOUCH_PROXY_SUBNET=10.89.0.0/24
EVENTOUCH_WEB_PROXY_IP=10.89.0.10
# 운영 기본은 요청ID·템플릿 경로·응답시간만 기록한다(개인정보·토큰 제외).
EVENTOUCH_REQUEST_LOGS=1
# 공개 신청의 분당 새 요청 제한. 같은 영수증 재확인은 새 신청으로 세지 않는다.
EVENTOUCH_SIGNUP_ADDRESS_LIMIT=600
EVENTOUCH_SIGNUP_EVENT_LIMIT=3000
EVENTOUCH_SIGNUP_WINDOW_SECONDS=60
# 자동 유지보수와 예약 자동 발송은 각각 명시적으로 활성화해야 한다.
EVENTOUCH_MESSAGE_MAINTENANCE=0
EVENTOUCH_MESSAGE_AUTO_SEND_DUE=0
EVENTOUCH_MESSAGE_MAINTENANCE_INTERVAL_MS=60000

# 문자·알림톡 발송 (Solapi). 세 값이 모두 있어야 실제 발송된다.
# 값이 없으면 캠페인은 NEEDS_CONNECTION 으로만 기록되고 발송되지 않는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 사전 등록한 발신번호. 숫자만 사용한다.
SOLAPI_SENDER=
# 카카오 알림톡 채널 프로필 ID(PF...). 없으면 알림톡 발송을 만들 수 없다.
SOLAPI_KAKAO_PFID=
