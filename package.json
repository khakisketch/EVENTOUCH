{
  "name": "eventouch",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "npm ci && npm --prefix apps/web ci",
    "dev": "node scripts/dev-supervisor.cjs",
    "start": "node scripts/start-supervisor.cjs",
    "build": "npm run server:typecheck && npm --prefix apps/web run build",
    "api:start": "node server/server.js",
    "db:migrate": "node server/migrate.js",
    "backup": "node scripts/backup.cjs",
    "backup:verify": "node scripts/backup.cjs --verify",
    "backup:scheduled": "node scripts/backup-schedule.cjs",
    "backup:check": "node scripts/backup-check.cjs",
    "ops:readiness": "node scripts/ops-readiness.cjs",
    "ops:notify": "node scripts/ops-notify.cjs",
    "security:audit": "node scripts/security-audit.cjs",
    "perf:reads": "node scripts/scoped-read-performance.cjs",
    "restore": "node scripts/restore.cjs",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "test": "node scripts/run-tests.cjs",
    "verify:system": "node scripts/verify-system.cjs",
    "test:raw": "node --test tests/*.test.cjs",
    "a11y": "node scripts/accessibility-audit.cjs",
    "mobile": "node scripts/mobile-audit.cjs",
    "web:audit": "node scripts/web-audit.cjs",
    "web:console:audit": "node scripts/web-console-audit.cjs",
    "web:white:audit": "node scripts/web-white-product-audit.cjs",
    "web:system:audit": "node scripts/web-system-improvement-audit.cjs",
    "web:organizations:audit": "node scripts/web-system-improvement-organizations.cjs",
    "web:organization-roles:audit": "node scripts/web-system-improvement-organization-roles.cjs",
    "web:recovery:audit": "node scripts/web-system-improvement-errors.cjs",
    "web:cards:audit": "node scripts/web-event-card-a2-audit.cjs",
    "web:close:audit": "node scripts/web-event-close-journey-audit.cjs",
    "web:workbench:audit": "node scripts/web-workbench-audit.cjs",
    "web:roster-retry:audit": "node scripts/web-roster-bulk-retry-audit.cjs",
    "web:preparation:audit": "node scripts/web-preparation-journey-audit.cjs",
    "web:signup-retry:audit": "node scripts/web-signup-retry-audit.cjs",
    "web:crossrole:audit": "node scripts/web-crossrole-journey-audit.cjs",
    "web:lifecycle:audit": "node scripts/web-lifecycle-ui-audit.cjs",
    "web:account-recovery:audit": "node scripts/web-account-recovery-audit.cjs",
    "web:import:audit": "node scripts/web-import-audit.cjs",
    "web:hanwool:audit": "node scripts/web-hanwool-audit.cjs",
    "web:theme:audit": "node scripts/web-theme-audit.cjs",
    "web:retirement:audit": "node scripts/web-retirement-audit.cjs",
    "audit:usability": "node scripts/usability-audit.cjs",
    "web:dev": "PORT=8777 npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:start": "PORT=8777 npm --prefix apps/web run start"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "fflate": "0.8.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
