# EVENTOUCH 서버 환경변수 예시. 실제 값은 tasks-manager 등 비밀 저장소에 둔다.
# 배포 전 체크: ADMIN_PASSWORD 생성됨, API_HOST_HERE 교체됨, COOKIE_SECURE 결정됨.
PORT=8776
DATA_DIR=./data/server
STORAGE_DIR=./data/storage
SESSION_TTL_HOURS=12
# 외부 HTTPS 공개 시 1. 내부 HTTP 운영 시 0.
COOKIE_SECURE=0
# 필수. 비워 두면 관리자 로그인이 막힌다. 절대 커밋하지 않는다.
ADMIN_PASSWORD=
# 개발 편의를 위한 기본 관리자 허용. 운영에서는 절대 1로 두지 않는다.
ALLOW_DEV_DEFAULT_ADMIN=0
