# EVENTOUCH 서버 환경변수 예시. 실제 값은 tasks-manager 등 비밀 저장소에 둔다.
# 배포 전 체크: ADMIN_EMAIL/ADMIN_PASSWORD 설정됨, API_HOST_HERE 교체됨, COOKIE_SECURE 결정됨.
PORT=8776
DATA_DIR=./data/server
STORAGE_DIR=./data/storage
POSTGRES_DB=eventouch
POSTGRES_USER=eventouch
# Compose용 DB 비밀번호. 비밀 저장소에 설정한다.
POSTGRES_PASSWORD=
# Compose 외부에서 직접 서버를 실행할 때 사용한다.
DATABASE_URL=postgresql://eventouch:<password>@localhost:5432/eventouch
SESSION_TTL_HOURS=12
# 외부 HTTPS 공개 시 1. 내부 HTTP 운영 시 0.
COOKIE_SECURE=0
# 최초 AGENCY 계정 생성에 둘 다 필요하다. 비밀값은 절대 커밋하지 않는다.
ADMIN_EMAIL=
ADMIN_NAME=관리자
ADMIN_PASSWORD=
