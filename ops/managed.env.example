# 실제 값은 Git 밖의 비밀 저장소에 둔다. docker-compose.managed.yml 전용.
# Supabase Connect 화면의 실제 direct 또는 session endpoint를 사용한다.
# sslmode=require가 붙어 있다면 제거하고 검증 정책은 아래 설정으로 고정한다.
DATABASE_URL=
DATABASE_SCHEMA=eventouch
PGPOOL_MAX=5
# 아래 두 값은 호스트 백업용. 컨테이너에서는 같은 CA를 /run/secrets에 읽기 전용 마운트한다.
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=
DATABASE_DIRECT_URL=
EVENTOUCH_DB_CA_PATH=
# 호스트에서 먼저 마운트한 파일 디렉터리. 컨테이너 UID 1000의 접근 권한을 준비한다.
EVENTOUCH_STORAGE_PATH=
# 호스트 백업에서도 같은 사전 마운트 경로를 사용한다.
STORAGE_DIR=
EVENTOUCH_STORAGE_MODE=mounted
# 해당 경로의 .eventouch-storage-id 내용. 프로그램은 이 파일을 만들지 않는다.
EVENTOUCH_STORAGE_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=관리자
COOKIE_SECURE=1
EVENTOUCH_PUBLIC_URL=
EVENTOUCH_BUILD_REVISION=unknown
HOST_PORT=8777
EVENTOUCH_PROXY_SUBNET=10.89.0.0/24
EVENTOUCH_WEB_PROXY_IP=10.89.0.10
# 발송은 기본 비활성. 실제 공급사·SMTP 설정과 수용은 INTEGRATIONS.md를 따른다.
EVENTOUCH_MESSAGE_MAINTENANCE=0
EVENTOUCH_MESSAGE_AUTO_SEND_DUE=0
